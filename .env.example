# ── acesso ──────────────────────────────────────────────────────────────────
# Primeiro usuário admin, criado só no primeiro boot com o banco vazio.
# Depois disso, mude a senha pelo app — alterar aqui não tem efeito.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Assina os cookies de sessão. Gere com: openssl rand -hex 32
# Sem isto, todo restart desloga todo mundo.
JWT_SECRET=

# Flag Secure do cookie de sessão. 'auto' marca Secure só quando a conexão é
# HTTPS de fato — é o que faz o app funcionar por http:// na rede local.
# Force 'true' apenas se você colocar um proxy TLS na frente.
COOKIE_SECURE=auto

# Duração da sessão: sem "manter conectado" e com ele.
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30

# ── servidor ────────────────────────────────────────────────────────────────
PORT=8080

# Dono do volume ./data. O container não roda como root, então estes precisam
# bater com o dono da pasta. Descubra com `id -u` e `id -g`.
PUID=1000
PGID=1000
LOG_LEVEL=info

# "host" deixa o container enxergar os hosts .local da sua rede — é o normal
# para uma fazenda caseira. Use "bridge" só se as impressoras tiverem IP fixo.
NETWORK_MODE=host

# ── impressoras ─────────────────────────────────────────────────────────────
# Liga o simulador com as 8 impressoras do design. Nenhuma máquina real é
# contatada — serve para percorrer as telas antes de cadastrar a fazenda.
MOCK_PRINTERS=false

# ── câmeras ─────────────────────────────────────────────────────────────────
# Taxa entregue quando o cliente não pede nada. A parede pede 2 fps sozinha.
CAMERA_FPS=5
# Sem quadro novo por este tempo, abrimos um alerta de câmera muda.
CAMERA_TIMEOUT_MS=60000

# ── backup ──────────────────────────────────────────────────────────────────
# Cron do ciclo diário (minuto hora dia mês dia-da-semana). Impressoras que
# estiverem trabalhando na hora entram na fila e são copiadas ao ficarem ociosas
# — nenhum backup roda em máquina ocupada.
BACKUP_CRON=0 3 * * *

# Quanto tempo um backup pode ficar velho. Quando uma impressora reaparece na
# rede, o sistema confere o último backup dela: se passou deste tempo, roda um
# de recuperação na hora. É o que cobre as máquinas que estavam desligadas na
# janela das 03:00.
BACKUP_INTERVALO_HORAS=24
# Espera depois de a impressora aparecer, para o Klipper terminar de subir.
BACKUP_ESPERA_ONLINE_MS=30000
# Quantos snapshots guardar por impressora.
BACKUP_KEEP=7
# Incluir os G-code no backup. Eles são deduplicados por hash entre as
# máquinas, mas ainda são a maior parte do volume — desligue se o disco apertar.
BACKUP_GCODE=true
# Teto de G-code baixado por impressora em cada ciclo (bytes). Padrão 2 GB.
BACKUP_GCODE_MAX_BYTES=2147483648
