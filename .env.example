# ── Access ──────────────────────────────────────────────────────────────────
# First admin user, created only on the first boot with an empty database.
# After that, change the password in the app — editing this file has no effect.
# The server refuses to create the admin if this is shorter than 8 characters
# or still the example value below.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# Signs the session cookies. Generate with: openssl rand -hex 32
# Without it, every restart signs everyone out.
JWT_SECRET=

# Secure flag on the session cookie. 'auto' sets Secure only when the
# connection really is HTTPS — that is what makes the app work over http:// on
# a local network. Force 'true' only if you put a TLS proxy in front.
COOKIE_SECURE=auto

# Session lifetime: without "keep me signed in", and with it.
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# Owner of the ./data volume. The container does not run as root, so these must
# match the folder's owner. Find yours with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Keep 'host'. The container needs to see the LAN directly: multicast does not
# cross Docker's default bridge, so .local (mDNS) addresses stop resolving on
# 'bridge'. Only switch if every printer has a fixed IP.
NETWORK_MODE=host

# ── Printers ────────────────────────────────────────────────────────────────
# Brings up the simulator with the eight printers from the design. No real
# machine is contacted — use it to walk the screens before registering a farm.
MOCK_PRINTERS=false

# ── Queue ───────────────────────────────────────────────────────────────────
# By default a queued job waits for someone to press start: when a print
# finishes the part is still on the bed, and starting the next one on top of it
# ruins both. Set to true only if your farm clears beds automatically.
QUEUE_AUTO_START=false

# ── Cameras ─────────────────────────────────────────────────────────────────
# Frame rate served when a client does not ask for one. The camera wall asks
# for 2 fps on its own.
CAMERA_FPS=5
# No new frame for this long opens a "camera went quiet" alert.
CAMERA_TIMEOUT_MS=60000

# ── Backup ──────────────────────────────────────────────────────────────────
# Cron for the daily cycle (minute hour day month weekday). Printers that are
# working at that moment are queued and copied once idle — no backup ever runs
# on a busy machine.
BACKUP_CRON=0 3 * * *

# How stale a backup may get. When a printer reappears on the network the
# system checks its last backup: if more than this has passed, it is queued for
# a catch-up run. This is what covers machines that were switched off at 03:00.
BACKUP_INTERVAL_HOURS=24
# Grace period after a printer appears, so Klipper can finish booting.
BACKUP_WAIT_AFTER_ONLINE_MS=30000

# How many snapshots to keep per printer.
BACKUP_KEEP=7
# Include G-code in the backup. Files are deduplicated by hash across machines,
# but they are still the bulk of the volume — turn this off if disk is tight.
BACKUP_GCODE=true
# Cap on G-code downloaded per printer per cycle, in bytes. Default 2 GB.
BACKUP_GCODE_MAX_BYTES=2147483648
